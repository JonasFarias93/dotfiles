#!/usr/bin/env bash
# =============================================================================
# new-project — cria um novo projeto com estrutura e layout Zellij
# Uso: new-project <nome> <tipo> [shells]
#
# Exemplos:
#   new-project minha-api python-django 4
#   new-project estudo-linux linuxlab 2
#   new-project app-flet python-flet 3
# =============================================================================

set -e

GREEN='\033[0;32m'; YELLOW='\033[1;33m'; BLUE='\033[0;34m'; RED='\033[0;31m'; NC='\033[0m'
log()  { echo -e "${GREEN}[✓]${NC} $1"; }
info() { echo -e "${BLUE}[→]${NC} $1"; }
err()  { echo -e "${RED}[✗]${NC} $1"; exit 1; }

# ------------------------------------------------------------------------------
# ARGUMENTOS
# ------------------------------------------------------------------------------
PROJECT_NAME="${1:-}"
PROJECT_TYPE="${2:-python}"
SHELLS="${3:-2}"

PROJECTS_DIR="$HOME/projects"
TEMPLATES_DIR="$HOME/dev-templates/types"

# Validações
[ -z "$PROJECT_NAME" ] && err "Uso: new-project <nome> <tipo> [shells]\n  Tipos disponíveis: $(ls "$TEMPLATES_DIR" 2>/dev/null | tr '\n' ' ')"
[ ! -d "$TEMPLATES_DIR/$PROJECT_TYPE" ] && err "Tipo '$PROJECT_TYPE' não encontrado em $TEMPLATES_DIR\n  Disponíveis: $(ls "$TEMPLATES_DIR" | tr '\n' ' ')"
[[ "$SHELLS" =~ ^[1-9]$ ]] || err "Número de shells deve ser entre 1 e 9"

PROJECT_DIR="$PROJECTS_DIR/$PROJECT_NAME"
[ -d "$PROJECT_DIR" ] && err "Projeto '$PROJECT_NAME' já existe em $PROJECT_DIR"

# ------------------------------------------------------------------------------
# 1. CRIAR PASTA DO PROJETO
# ------------------------------------------------------------------------------
info "Criando projeto '$PROJECT_NAME' (tipo: $PROJECT_TYPE, shells: $SHELLS)..."
mkdir -p "$PROJECT_DIR"

# ------------------------------------------------------------------------------
# 2. COPIAR TEMPLATE
# ------------------------------------------------------------------------------
info "Copiando template '$PROJECT_TYPE'..."
cp -r "$TEMPLATES_DIR/$PROJECT_TYPE/." "$PROJECT_DIR/"

# Substituir placeholder do nome do projeto nos arquivos copiados
find "$PROJECT_DIR" -type f | while read -r file; do
  sed -i "s/{{PROJECT_NAME}}/$PROJECT_NAME/g" "$file" 2>/dev/null || true
done

log "Template copiado"

# ------------------------------------------------------------------------------
# 3. GERAR LAYOUT ZELLIJ
# ------------------------------------------------------------------------------
info "Gerando layout Zellij com $SHELLS shell(s)..."

LAYOUT_FILE="$PROJECT_DIR/.zellij.kdl"
ZELLIJ_LAYOUTS_DIR="$HOME/.config/zellij/layouts"
mkdir -p "$ZELLIJ_LAYOUTS_DIR"

# Carrega o gerador de layout do tipo do projeto
LAYOUT_GENERATOR="$TEMPLATES_DIR/$PROJECT_TYPE/generate_layout.sh"

if [ -f "$LAYOUT_GENERATOR" ]; then
  # O tipo tem um gerador personalizado
  bash "$LAYOUT_GENERATOR" "$PROJECT_NAME" "$PROJECT_DIR" "$SHELLS" > "$LAYOUT_FILE"
else
  # Gerador genérico: grade de shells em branco
  _generate_generic_layout "$PROJECT_NAME" "$PROJECT_DIR" "$SHELLS" > "$LAYOUT_FILE"
fi

# Link do layout para o zellij encontrar pelo nome
ln -sf "$LAYOUT_FILE" "$ZELLIJ_LAYOUTS_DIR/$PROJECT_NAME.kdl"
log "Layout gerado: ~/.config/zellij/layouts/$PROJECT_NAME.kdl"

# ------------------------------------------------------------------------------
# 4. GIT INIT
# ------------------------------------------------------------------------------
info "Inicializando repositório git..."
cd "$PROJECT_DIR"
git init -q
git add .
git commit -q -m "chore: initial project structure (template: $PROJECT_TYPE)"
log "Git inicializado"

# ------------------------------------------------------------------------------
# CONCLUÍDO
# ------------------------------------------------------------------------------
echo ""
echo -e "${GREEN}══════════════════════════════════════════════${NC}"
echo -e "${GREEN}  Projeto '$PROJECT_NAME' criado com sucesso! ${NC}"
echo -e "${GREEN}══════════════════════════════════════════════${NC}"
echo ""
echo "  Localização:  $PROJECT_DIR"
echo "  Tipo:         $PROJECT_TYPE"
echo "  Shells:       $SHELLS"
echo ""
echo "  Para abrir no Zellij:"
echo -e "  ${BLUE}zellij --layout $PROJECT_NAME${NC}"
echo ""
echo "  Ou entre na pasta e explore:"
echo -e "  ${BLUE}cd $PROJECT_DIR${NC}"
echo ""

# ------------------------------------------------------------------------------
# FUNÇÃO: gerador genérico de layout
# ------------------------------------------------------------------------------
_generate_generic_layout() {
  local name="$1"
  local dir="$2"
  local shells="$3"

  # Calcula linhas e colunas para grade aproximadamente quadrada
  local cols rows
  if   [ "$shells" -eq 1 ]; then cols=1; rows=1
  elif [ "$shells" -eq 2 ]; then cols=2; rows=1
  elif [ "$shells" -eq 3 ]; then cols=2; rows=2   # 3 painéis: 2 em cima, 1 embaixo
  elif [ "$shells" -eq 4 ]; then cols=2; rows=2
  elif [ "$shells" -le 6 ]; then cols=3; rows=2
  else                            cols=3; rows=3
  fi

  echo "// Layout gerado por new-project"
  echo "// Projeto: $name | Tipo: genérico | Shells: $shells"
  echo "//"
  echo "// Para personalizar, edite: $dir/.zellij.kdl"
  echo ""
  echo "layout {"

  local count=0
  for ((row=0; row<rows; row++)); do
    echo "    pane split_direction=\"horizontal\" {"
    for ((col=0; col<cols; col++)); do
      count=$((count + 1))
      [ "$count" -gt "$shells" ] && break
      echo "        pane cwd=\"$dir\" {"
      echo "            name \"shell-$count\""
      [ "$count" -eq 1 ] && echo "            focus true"
      echo "        }"
    done
    echo "    }"
    [ "$count" -ge "$shells" ] && break
  done

  echo "}"
}

export -f _generate_generic_layout
